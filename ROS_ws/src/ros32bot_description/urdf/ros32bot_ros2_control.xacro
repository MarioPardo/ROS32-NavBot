<?xml version="1.0"?>


<robot name="ros32bot" xmlns:xacro="http://ros.org/wiki/xacro">
    <ros2_control type="system" name="RobotSystem">

          <xacro:if value="$(arg is_sim)">
              
          <xacro:if value="$(arg is_ignition)">
                <hardware>
                    <plugin>ign_ros2_control/IgnitionSystem</plugin>
                </hardware>
            </xacro:if>

            <xacro:unless value="$(arg is_ignition)">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:unless>  

        </xacro:if>

        <xacro:unless value="$(arg is_sim)">
            <hardware>
                <plugin>ros32bot_middleware/Ros32BotInterface</plugin>
                <param name="port">$(arg port)</param>
                <param name="wheel_radius">0.033</param>
            </hardware>
        </xacro:unless>

      

        <joint name="wheel_right_joint">
            <command_interface name="velocity">
                <param name="min">-1</param> 
                <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/> <!-- how to receive feedback-->
            <state_interface name="velocity"/>
        </joint>
         <joint name="wheel_left_joint">
            <command_interface name="velocity">
                <param name="min">-1</param> 
                <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/> <!-- how to receive feedback-->
            <state_interface name="velocity"/>
        </joint>

    </ros2_control>


</robot>